{
  // Worker code: the Hono API in worker/. `Env` comes from
  // worker-configuration.d.ts. Run `pnpm types` after a binding changes.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    // ESNext.Disposable: tests use `await using` for Workflow introspectors.
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["worker", "worker-configuration.d.ts"]
}
