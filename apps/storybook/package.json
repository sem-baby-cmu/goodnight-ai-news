{
  "name": "@storybook/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "types": "wrangler types --env-file /dev/null",
    "typecheck": "wrangler types --check --env-file /dev/null && tsc -b",
    "test": "vitest run --project worker && vitest run --project ui && vitest run --project model-contract",
    "test:s2": "vitest run --config vitest.s2.config.ts",
    "spike:build": "tsx scripts/make-texture.ts && VITE_SPIKE=1 vite build && tsx scripts/copy-spike-assets.ts",
    "spike:preview": "tsx scripts/spike-preview.ts",
    "smoke:spike": "pnpm run spike:build && playwright test --config smoke/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/baloo-2": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@storybook/dsl": "workspace:*",
    "@storybook/layout": "workspace:*",
    "@storybook/models": "workspace:*",
    "@storybook/scene-runtime": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tw-animate-css": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "jsdom": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
