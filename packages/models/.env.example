# Environment for packages/models (the model adapter and scripts/probe-tts.ts).
# Copy to .env (ignored by git) and add the keys there. Never commit a key.
# Load it into the shell before the probe: set -a; . ./.env; set +a

# OpenAI-compatible text API. Development: the local gateway. Cloudflare: AI Gateway to OpenRouter.
OPENAI_BASE_URL=http://127.0.0.1:3425/v1
# Key for OPENAI_BASE_URL. Development: the local gateway key from the owner.
OPENAI_API_KEY=
# Model ID for the script step.
MODEL_SCRIPT=agy-cli/gemini-4-neon
# Model ID for the scene step.
MODEL_SCENE=auto/gpt-6.1-sol
# Model ID for TTS (Gemini generateContent).
MODEL_TTS=gemini-3.8-flash-tts
# Gemini API with its version. Development: https://generativelanguage.googleapis.com/v1beta
# Cloudflare: https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/google-ai-studio/v1beta
TTS_BASE_URL=
# Google AI Studio key, sent as x-goog-api-key.
TTS_API_KEY=
# Prebuilt TTS voice name.
TTS_VOICE=Kore
# Optional. AI Gateway token, sent as cf-aig-authorization on both routes.
AI_GATEWAY_TOKEN=
